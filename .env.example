# ============================================================================
# Environment Variables Example - Portal Layanan Pensiunan
# Salin file ini menjadi .env atau konfigurasi sesuai environment Anda
# ============================================================================

# Backend Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# PostgreSQL Database (Jika menggunakan mode container / Postgres)
POSTGRES_USER=lp_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=layanan_pensiunan
DATABASE_URL=postgresql://lp_admin:your_secure_postgres_password_here@localhost:5432/layanan_pensiunan

# Frontend Configuration
VITE_BACKEND_URL=http://localhost:4000
