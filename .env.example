# ============================================================================
# Environment Variables Example - Portal Layanan Pensiunan Enterprise
# Salin file ini menjadi .env pada direktori root atau backend/
# ============================================================================

# Backend Runtime & Security
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# JWT Secret: Wajib minimal 32 karakter unik pada mode production
# Generate dengan command: openssl rand -hex 32
JWT_SECRET=4f8b9e1a3c7d5f2e6a0b8c4d2e9f1a3b5c7e9d0f2a4b6c8d1e3f5a7b9c0d2e4f

# Database Persistence:
# Menggunakan SQLite terintegrasi (node:sqlite) pada backend/data/enterprise.sqlite
# Memerlukan runtime Node.js v22.5.0+ atau v24 LTS.

# PIN Pengaman Akses Portal Web (InstallGate PWA)
# Default: 153363 (Digunakan saat tester membuka web via browser)
PORTAL_SECURITY_PIN=153363

# Frontend API URL (Opsional: kosongkan jika di-serve satu origin oleh backend/Nginx)
# VITE_BACKEND_URL=https://simulasi.domainanda.id

